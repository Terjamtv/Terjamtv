<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📺 TranslateTV"
        android:textColor="#38BDF8"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مساعد التحكم والاقتران بالتلفزيون"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_marginTop="6dp" />

    <Button
        android:id="@+id/btnScanQr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📷 مسح رمز QR على شاشة التلفزيون"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#2563EB"
        android:padding="16dp"
        android:layout_marginTop="48dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="— أو أدخل الرمز يدوياً —"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:layout_marginTop="32dp" />

    <EditText
        android:id="@+id/etPairingCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="أدخل رمز الـ 6 أحرف (مثال: AB3X9Z)"
        android:textColorHint="#475569"
        android:textColor="#FFFFFF"
        android:background="#1E293B"
        android:padding="14dp"
        android:gravity="center"
        android:letterSpacing="0.2"
        android:textAllCaps="true"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnManualPair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ربط التلفزيون"
        android:textColor="#FFFFFF"
        android:backgroundTint="#334155"
        android:padding="12dp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="جاهز للاقتران..."
        android:textColor="#CBD5E1"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginTop="40dp" />

</LinearLayout>
