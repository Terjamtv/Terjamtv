<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0A0F1D"
    android:padding="48dp"
    android:gravity="center">

    <!-- QR Code Section -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#1E293B"
        android:padding="24dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/ivQrCode"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:background="#FFFFFF"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvPairingCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="------"
            android:textColor="#FBBF24"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- Instructions & Action Section -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TranslateTV (Android TV)"
            android:textColor="#60A5FA"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="امسح رمز الاستجابة السريعة (QR) باستخدام هاتفك لبدء ترجمة ما يظهر على الشاشة فورياً."
            android:textColor="#CBD5E1"
            android:textSize="20sp"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="جاري التهيئة..."
            android:textColor="#38BDF8"
            android:textSize="18sp"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnStartTranslation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 بدء وضع ترجمة البلايستيشن والألعاب (PlayStation Mode)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="24dp"
            android:enabled="true" />

    </LinearLayout>

</LinearLayout>
